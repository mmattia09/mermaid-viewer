{
  "name": "mermaid-viewer",
  "version": "1.1.0",
  "private": true,
  "description": "%description%",
  "type": "module",
  "bin": {
    "mmv": "./mmv"
  },
  "scripts": {
    "start": "bun server.ts",
    "vendor": "node scripts/vendor.mjs",
    "test": "bun test tests/*.test.js && node test.mjs tests/fixtures",
    "package:extension": "mkdir -p artifacts && vsce package --no-dependencies --out artifacts/mermaid-viewer.vsix",
    "test:extension": "node scripts/test-extension.mjs"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0",
    "jsdom": "^29.1.1",
    "jspdf": "^4.2.1",
    "mermaid": "^11.0.0",
    "pele": "1.6.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "displayName": "Mermaid Viewer — Pele & Mermaid",
  "publisher": "mmattia09",
  "license": "MIT",
  "main": "./extension/extension.cjs",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mmattia09/mermaid-viewer.git"
  },
  "contributes": {
    "commands": [
      {
        "command": "mermaidViewer.openPreview",
        "title": "%command%",
        "category": "Mermaid Viewer",
        "icon": "$(open-preview)"
      }
    ],
    "languages": [
      {
        "id": "mermaid",
        "aliases": [
          "Mermaid"
        ],
        "extensions": [
          ".mmd",
          ".mermaid"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/mermaid-light.svg",
          "dark": "./icons/mermaid-dark.svg"
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mermaidViewer.openPreview",
          "when": "resourceExtname == .mmd || resourceExtname == .mermaid",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "mermaidViewer.openPreview",
          "when": "resourceExtname == .mmd || resourceExtname == .mermaid",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "mermaidViewer.openPreview",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorTextFocus && editorLangId == mermaid"
      }
    ],
    "configuration": {
      "title": "Mermaid Viewer",
      "properties": {
        "mermaidViewer.engine": {
          "type": "string",
          "enum": [
            "pele",
            "mermaid"
          ],
          "default": "pele",
          "description": "%engine%"
        },
        "mermaidViewer.responsive": {
          "type": "boolean",
          "default": true,
          "description": "%responsive%"
        }
      }
    },
    "grammars": [
      {
        "language": "mermaid",
        "scopeName": "source.mermaid",
        "path": "./syntaxes/mermaid.tmLanguage.json"
      }
    ]
  }
}
